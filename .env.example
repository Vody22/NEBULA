# --- Multiplayer server (Node) ---
# Port to listen on (Render / Fly set it automatically).
PORT=8080
# Browser origins allowed to open the WebSocket, comma-separated; * wildcards allowed.
ALLOWED_ORIGINS=https://nebula-iota-rust.vercel.app,https://nebula-*.vercel.app
# Pilots per sector (one server process = one sector).
MAX_PLAYERS=30
# Snapshot every N ticks of 1/60 s (3 = 20 Hz).
SNAPSHOT_EVERY=3
# Seconds a disconnected pilot's session survives for reconnection.
RECONNECT_GRACE=20
# Sector generation seed (all clients receive it).
SECTOR_SEED=1337
# Folder with the built client served by the same process (optional).
STATIC_DIR=dist

# --- Client (Vercel environment variable, read at build time) ---
# VITE_SERVER_URL=wss://nebula-frontier-server.onrender.com/ws

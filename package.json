{
  "name": "nebula-frontier",
  "version": "0.6.0",
  "private": true,
  "description": "NEBULA FRONTIER — MMO spatial 3D (prototype pilotage & combat)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "ui-check": "node scripts/ui-check.mjs",
    "build:server": "esbuild src/server/node/main.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist-server/server.mjs",
    "server": "npm run build:server && node dist-server/server.mjs",
    "start": "node dist-server/server.mjs"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
